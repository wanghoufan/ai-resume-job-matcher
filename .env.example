# 用于内置 DeepSeek 模式。请复制为 .env.local 后填写真实值。
DEEPSEEK_API_KEY=your_deepseek_api_key
# 兼容服务基地址；应用会追加 /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：默认使用 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat

# Supabase（浏览器可安全使用的项目地址和 Publishable Key；不要填写 service_role key）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google OAuth 的 Client ID / Secret 必须保存在 Supabase Dashboard，不要放进本地环境变量或前端代码。
# 配置步骤见 SUPABASE_AUTH_SETUP.md。
