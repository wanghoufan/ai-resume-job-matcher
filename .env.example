# Supabase（浏览器可安全使用的项目地址和 Publishable Key；不要填写 service_role key）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google OAuth 的 Client ID / Secret 必须保存在 Supabase Dashboard，不要放进本地环境变量或前端代码。
# 配置步骤见 SUPABASE_AUTH_SETUP.md。

# Waffo Pancake（仅服务端使用；真实密钥只放在 .env.local / Vercel 环境变量）
WAFFO_MERCHANT_ID=MER_your_merchant_id
WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----"
WAFFO_STORE_ID=STO_your_store_id
WAFFO_MONTHLY_PRODUCT_ID=PROD_your_monthly_product_id
WAFFO_YEARLY_PRODUCT_ID=PROD_your_yearly_product_id

# Webhook 写入 Supabase 所需，仅限服务端；不得添加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
